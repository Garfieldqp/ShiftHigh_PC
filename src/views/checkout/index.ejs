<%# หน้า checkout - กรอกที่อยู่จัดส่ง + เลือกวิธีชำระเงิน ก่อนกดยืนยันสั่งซื้อ %>
<div class="max-w-xl mx-auto px-4 py-10">
  <p class="alert-error mb-4"><%= t('ระบบสาธิต: การชำระเงินเป็นการจำลอง ไม่มีการเรียกเก็บเงินจริง') %></p>
<h1 class="page-title mb-6"><%= t('ชำระเงิน') %></h1>

  <% if (error) { %>
    <div class="alert-error mb-4"><%= t(error) %></div>
  <% } %>

  <% if (items.length === 0) { %>
    <div class="empty-state">
      <p class="mb-4"><%= t('ตะกร้าว่าง ไม่สามารถชำระเงินได้') %></p>
      <a href="/products" class="btn-primary"><%= t('ไปเลือกซื้อสินค้า') %></a>
    </div>
  <% } else { %>
    <div class="card divide-y divide-gray-100 mb-4">
      <% items.forEach(function(item) { %>
        <div class="flex items-center justify-between px-5 py-3 text-sm">
          <span class="text-gray-700"><%= t(item.name) %><%= item.type === 'product' ? ` × ${item.quantity}` : '' %></span>
          <span class="font-medium"><%= item.line_total.toLocaleString() %> <%= t('บาท') %></span>
        </div>
      <% }); %>
      <div class="flex items-center justify-between px-5 py-3.5 bg-gray-50 rounded-b-2xl">
        <span class="font-semibold"><%= t('รวมทั้งหมด') %></span>
        <span class="font-bold text-brand-600 text-lg"><%= total.toLocaleString() %> <%= t('บาท') %></span>
      </div>
    </div>

    <form method="POST" action="/checkout" class="card p-5 space-y-4">
      <div>
        <div class="flex items-center justify-between mb-1.5">
          <label class="field-label !mb-0"><%= t('ที่อยู่จัดส่ง') %></label>
          <a href="/account" class="text-xs link"><%= t('แก้ไขที่อยู่ในบัญชี') %></a>
        </div>

        <% if (savedAddress) { %>
          <label class="flex items-start gap-2 mb-3 text-sm text-gray-600 cursor-pointer">
            <input type="checkbox" id="use-saved-address" checked class="mt-0.5" />
            <%= t('ใช้ที่อยู่ตามข้อมูลที่กรอกไว้ในระบบ') %>
          </label>
        <% } %>

        <textarea
          name="shipping_address"
          id="shipping-address"
          rows="3"
          placeholder="<%= t('บ้านเลขที่ ถนน แขวง/ตำบล เขต/อำเภอ จังหวัด รหัสไปรษณีย์') %>"
          class="input"
          required
        ><%= savedAddress || '' %></textarea>
      </div>

      <div>
        <label class="field-label"><%= t('วิธีชำระเงิน') %></label>
        <div class="grid sm:grid-cols-2 gap-3">
          <label>
            <input type="radio" name="payment_method" value="cod" checked class="sr-only peer" />
            <div class="payment-option-box">
              <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="8" width="11" height="7" rx="1" /><path stroke-linecap="round" stroke-linejoin="round" d="M13 10h3l3 2.5V15h-6" /><circle cx="6" cy="17" r="1.3" fill="currentColor" stroke="none" /><circle cx="16" cy="17" r="1.3" fill="currentColor" stroke="none" /></svg>
              <%= t('เก็บเงินปลายทาง') %>
            </div>
          </label>
          <label>
            <input type="radio" name="payment_method" value="bank_transfer" class="sr-only peer" />
            <div class="payment-option-box">
              <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 9l8-5 8 5" /><rect x="5" y="9" width="14" height="8" rx="0.5" /><path stroke-linecap="round" d="M3 17h18M8 9v8M12 9v8M16 9v8" /></svg>
              <%= t('โอนเงิน') %>
            </div>
          </label>
        </div>
      </div>

      <button class="btn-primary w-full"><%= t('ยืนยันการสั่งซื้อ') %></button>
    </form>

    <% if (savedAddress) { %>
      <script>
        (function () {
          const checkbox = document.getElementById('use-saved-address');
          const textarea = document.getElementById('shipping-address');
          const savedAddress = <%- JSON.stringify(savedAddress) %>;
          function sync() {
            if (checkbox.checked) {
              textarea.value = savedAddress;
              textarea.readOnly = true;
              textarea.classList.add('bg-gray-50', 'text-gray-500');
            } else {
              textarea.readOnly = false;
              textarea.value = '';
              textarea.classList.remove('bg-gray-50', 'text-gray-500');
              textarea.focus();
            }
          }
          checkbox.addEventListener('change', sync);
          sync();
        })();
      </script>
    <% } %>
  <% } %>
</div>
