<%# หน้ารายละเอียดงานจัดสเปคคอม 1 งาน (ฝั่งช่าง) - รับงาน/อัปเดตสถานะประกอบ %>
<div class="max-w-2xl mx-auto px-4 py-10">
  <a href="/technician/queue" class="link text-sm inline-flex items-center gap-1 mb-6">
    <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15l-5-5 5-5" /></svg>
    <%= t('กลับไปคิวงาน') %>
  </a>

  <% if (!build) { %>
    <div class="empty-state"><p><%= t('ไม่พบงานนี้') %></p></div>
  <% } else { %>
    <div class="flex items-start justify-between mb-6 gap-3">
      <div class="min-w-0">
        <div class="control-label mb-1"><%= t('ชื่อชุดจัดสเปค') %></div>
        <div class="flex items-center gap-2 min-w-0">
          <span class="id-tag">#<%= build.build_id %></span>
          <h1 class="page-title truncate min-w-0"><%= build.build_name %></h1>
        </div>
      </div>
      <span class="<%= statusColor(build.status) %> shrink-0"><%= t(statusLabel(build.status)) %></span>
    </div>

    <% if (customer) { %>
      <!-- ข้อมูลติดต่อลูกค้า - เผื่อประกอบแล้วมีปัญหา/มีคำถามต้องโทรถาม -->
      <div class="card p-5 mb-6 flex items-center gap-4">
        <div class="h-10 w-10 rounded-full bg-brand-50 text-brand-600 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M5.5 5.5c-1 3 4 12 6 13.5 2 1.5 3-1 4-1.5s2.5.5 3.5 1.5-1 3-2 3c-4 0-13-8-13-13 0-1 1.5-3 3-2 1 1 2 2.5 1.5 3.5s-3 1-3-1.5z" /></svg>
        </div>
        <div class="min-w-0">
          <div class="control-label mb-0.5"><%= t('ลูกค้า') %></div>
          <div class="font-medium text-gray-900"><%= customer.full_name %></div>
          <div class="text-sm text-gray-500">
            <%= customer.phone ? formatPhone(customer.phone) : t('ไม่มีเบอร์โทรในระบบ') %> · <%= customer.email %>
          </div>
        </div>
      </div>
    <% } %>

    <div class="card divide-y divide-gray-100 mb-6">
      <% items.forEach(function(item) { %>
        <div class="flex items-center justify-between px-4 sm:px-5 py-3 text-sm">
          <span class="text-gray-700"><%= item.product_name %> × <%= item.quantity %></span>
        </div>
      <% }); %>
    </div>

    <div class="card p-5 mb-8">
      <% if (build.status === 'paid') { %>
        <form method="POST" action="/technician/builds/<%= build.build_id %>/claim">
          <button class="btn-primary w-full"><%= t('รับงานนี้') %></button>
        </form>
      <% } else if (build.status === 'assigned' || build.status === 'assembling') { %>
        <!-- ช่างปรับได้แค่ กำลังประกอบ / ประกอบเสร็จ / ยกเลิกประกอบ - สถานะจัดส่งหลังจากนี้เป็นหน้าที่ staff -->
        <form method="POST" action="/technician/builds/<%= build.build_id %>/status" id="build-status-form" class="space-y-3">
          <div class="flex flex-col sm:flex-row gap-3">
            <select name="status" id="build-status-select" class="select sm:w-48">
              <option value="assembling"><%= t('กำลังประกอบ') %></option>
              <option value="completed"><%= t('ประกอบเสร็จ') %></option>
              <option value="cancelled"><%= t('ยกเลิกประกอบ') %></option>
            </select>
            <input name="note" id="build-status-note" placeholder="<%= t('หมายเหตุ (ถ้ามี)') %>" class="input flex-1" />
          </div>
          <p id="cancel-hint" class="alert-error hidden">
            <%= t('ใช้ตัวเลือกนี้เมื่อช่างและลูกค้าตกลงกันแล้วว่าประกอบไม่ได้จริงๆ (เช่น อะไหล่เข้ากันไม่ได้) - ระบบจะคืนอะไหล่ทั้งหมดกลับเข้าสต็อก กรุณาระบุเหตุผลในช่องหมายเหตุ') %>
          </p>
          <button id="build-status-submit" class="btn-primary w-full"><%= t('อัปเดตสถานะ') %></button>
        </form>
        <script>
          (function () {
            const select = document.getElementById('build-status-select');
            const hint = document.getElementById('cancel-hint');
            const note = document.getElementById('build-status-note');
            const submitBtn = document.getElementById('build-status-submit');
            const PLACEHOLDER_NOTE = <%- JSON.stringify(t('หมายเหตุ (ถ้ามี)')) %>;
            const PLACEHOLDER_CANCEL_REASON = <%- JSON.stringify(t('เหตุผลที่ยกเลิก (จำเป็น)')) %>;
            const LABEL_UPDATE = <%- JSON.stringify(t('อัปเดตสถานะ')) %>;
            const LABEL_CONFIRM_CANCEL = <%- JSON.stringify(t('ยืนยันยกเลิกประกอบ')) %>;
            function sync() {
              const isCancel = select.value === 'cancelled';
              hint.classList.toggle('hidden', !isCancel);
              note.placeholder = isCancel ? PLACEHOLDER_CANCEL_REASON : PLACEHOLDER_NOTE;
              submitBtn.className = isCancel ? 'btn-danger w-full' : 'btn-primary w-full';
              submitBtn.textContent = isCancel ? LABEL_CONFIRM_CANCEL : LABEL_UPDATE;
            }
            select.addEventListener('change', sync);
            sync();
          })();
        </script>
      <% } else { %>
        <p class="text-sm text-gray-400">
          <%= build.status === 'cancelled' ? t('งานนี้ถูกยกเลิกแล้ว') : t('ประกอบเสร็จแล้ว - staff จะเป็นคนอัปเดตสถานะจัดส่งต่อจากนี้') %>
        </p>
      <% } %>
    </div>

    <h2 class="section-title mb-3"><%= t('ประวัติสถานะ') %></h2>
    <div class="card p-5">
      <ol class="relative border-l-2 border-brand-100 pl-5 space-y-5">
        <% if (history.length === 0) { %>
          <li class="text-sm text-gray-400"><%= t('ยังไม่มีการอัปเดตสถานะ') %></li>
        <% } %>
        <% history.forEach(function(h) { %>
          <li class="relative">
            <span class="absolute -left-[1.65rem] top-1 h-3 w-3 rounded-full bg-brand-500 ring-4 ring-brand-50"></span>
            <div class="font-medium text-gray-900"><%= t(statusLabel(h.status)) %></div>
            <div class="text-xs text-gray-400"><%= new Date(h.updated_at).toLocaleString(lang === 'en' ? 'en-GB' : 'th-TH') %></div>
            <% if (h.note) { %><div class="text-sm text-gray-500 mt-0.5"><%= t(h.note) %></div><% } %>
          </li>
        <% }); %>
      </ol>
    </div>
  <% } %>
</div>
