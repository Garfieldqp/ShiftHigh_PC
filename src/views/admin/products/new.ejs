<%# ฟอร์มเพิ่มสินค้าใหม่ (เฉพาะ admin) %>
<%- include('../../partials/admin-nav', { currentNav: 'products' }) %>
<div class="max-w-xl mx-auto px-4 pb-16">
  <h1 class="page-title mb-6"><%= t('เพิ่มสินค้าใหม่') %></h1>
  <% if (error) { %>
    <div class="alert-error mb-4"><%= t(error) %></div>
  <% } %>
  <% var fv = formValues || {}; %>
  <form method="POST" action="/admin/products" class="card p-6 space-y-4">
    <div>
      <label class="field-label"><%= t('ชื่อสินค้า') %></label>
      <input name="product_name" value="<%= fv.product_name || '' %>" class="input <%= errorField === 'product_name' ? 'input-error' : '' %>" required />
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="field-label"><%= t('หมวดหมู่') %></label>
        <select name="category_id" class="select <%= errorField === 'category_id' ? 'input-error' : '' %>" required>
          <option value=""><%= t('เลือกหมวดหมู่') %></option>
          <% categories.forEach(function(c) { %><option value="<%= c.category_id %>" <%= String(fv.category_id) === String(c.category_id) ? 'selected' : '' %>><%= t(c.category_name) %></option><% }); %>
        </select>
      </div>
      <div>
        <label class="field-label"><%= t('แบรนด์') %></label>
        <select name="brand_id" class="select <%= errorField === 'brand_id' ? 'input-error' : '' %>" required>
          <option value=""><%= t('เลือกแบรนด์') %></option>
          <% brands.forEach(function(b) { %><option value="<%= b.brand_id %>" <%= String(fv.brand_id) === String(b.brand_id) ? 'selected' : '' %>><%= b.brand_name %></option><% }); %>
        </select>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="field-label"><%= t('ราคา') %></label>
        <input name="price" type="number" min="0.01" step="0.01" value="<%= fv.price || '' %>" class="input <%= errorField === 'price' ? 'input-error' : '' %>" required />
      </div>
      <div>
        <label class="field-label"><%= t('จำนวนสต็อกเริ่มต้น') %></label>
        <input name="stock_quantity" type="number" min="0" value="<%= fv.stock_quantity || '' %>" class="input <%= errorField === 'stock_quantity' ? 'input-error' : '' %>" />
      </div>
    </div>
    <div>
      <label class="field-label"><%= t('รายละเอียดสเปค') %></label>
      <p class="text-xs text-gray-400 mb-1.5"><%= t('พิมพ์ทีละบรรทัด รูปแบบ "หัวข้อ: ค่า" เช่น คอร์ / เธรด: 6 คอร์ / 12 เธรด') %></p>
      <textarea name="spec_detail" rows="6" class="input font-mono text-sm"><%= fv.spec_detail || '' %></textarea>
    </div>
    <div>
      <label class="field-label"><%= t('ลิงก์รูปภาพ (ไม่บังคับ)') %></label>
      <input name="image_url" value="<%= fv.image_url || '' %>" class="input" />
    </div>
    <div>
      <label class="field-label"><%= t('รับประกัน (เดือน)') %></label>
      <input name="warranty_months" type="number" min="0" value="<%= fv.warranty_months || '' %>" class="input <%= errorField === 'warranty_months' ? 'input-error' : '' %>" />
    </div>
    <button class="btn-primary w-full"><%= t('บันทึก') %></button>
  </form>
</div>
