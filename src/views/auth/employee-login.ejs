<%# ฟอร์มเข้าสู่ระบบฝั่งพนักงาน %>
<div class="max-w-sm mx-auto px-4 py-16">
  <div class="card p-8">
    <div class="text-center mb-6">
      <img src="/images/logo.jpg" alt="Shift-High PC" class="h-12 w-12 rounded-xl object-cover mx-auto mb-3 ring-1 ring-gray-100" />
      <h1 class="text-xl font-bold"><%= t('เข้าสู่ระบบพนักงาน') %></h1>
    </div>

    <% if (error) { %>
      <div class="alert-error mb-4"><%= t(error) %></div>
    <% } %>

    <form method="POST" action="/staff/auth/login" class="space-y-4">
      <div>
        <label class="field-label"><%= t('อีเมล') %></label>
        <input name="email" type="email" class="input <%= errorField === 'email' ? 'input-error' : '' %>" required />
      </div>
      <div>
        <label class="field-label"><%= t('รหัสผ่าน') %></label>
        <input name="password" type="password" placeholder="••••••••" class="input <%= errorField === 'password' ? 'input-error' : '' %>" required />
      </div>
      <button class="btn-primary w-full"><%= t('เข้าสู่ระบบ') %></button>
    </form>

    <p class="mt-5 text-center text-sm text-gray-500">
      <%= t('ยังไม่มีบัญชี?') %> <a href="/staff/auth/register" class="link"><%= t('สมัครเป็นพนักงาน') %></a>
    </p>
  </div>
  <div class="mt-4 text-center text-xs text-gray-400 leading-relaxed">
    <%= t('ทดสอบ') %>: admin@shift-high-pc.example / admin1234<br />
    staff@shift-high-pc.example / staff1234<br />
    technician@shift-high-pc.example / tech1234
  </div>
</div>
