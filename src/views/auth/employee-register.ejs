<%# ฟอร์มสมัครสมาชิกฝั่งพนักงาน - สมัครเสร็จ role เริ่มเป็น unassigned ต้องรอ admin อนุมัติ %>
<div class="max-w-sm mx-auto px-4 py-16">
  <div class="card p-8">
    <div class="text-center mb-6">
      <img src="/images/logo.jpg" alt="Shift-High PC" class="h-12 w-12 rounded-xl object-cover mx-auto mb-3 ring-1 ring-gray-100" />
      <h1 class="text-xl font-bold"><%= t('สมัครเป็นพนักงาน') %></h1>
    </div>

    <% if (error) { %>
      <div class="alert-error mb-4"><%= t(error) %></div>
    <% } %>

    <form method="POST" action="/staff/auth/register" class="space-y-4">
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="field-label"><%= t('ชื่อ') %></label>
          <input name="first_name" placeholder="<%= lang === 'en' ? 'John' : 'สมชาย' %>" class="input <%= errorField === 'first_name' ? 'input-error' : '' %>" required />
        </div>
        <div>
          <label class="field-label"><%= t('นามสกุล') %></label>
          <input name="last_name" placeholder="<%= lang === 'en' ? 'Doe' : 'ใจดี' %>" class="input <%= errorField === 'last_name' ? 'input-error' : '' %>" required />
        </div>
      </div>
      <div>
        <label class="field-label"><%= t('อีเมล') %></label>
        <input name="email" type="email" class="input <%= errorField === 'email' ? 'input-error' : '' %>" required />
      </div>
      <div>
        <label class="field-label"><%= t('เบอร์โทร') %></label>
        <input
          name="phone"
          type="tel"
          inputmode="numeric"
          maxlength="10"
          pattern="[0-9]{10}"
          placeholder="0812345678"
          data-phone-input
          class="input <%= errorField === 'phone' ? 'input-error' : '' %>"
        />
      </div>
      <div>
        <label class="field-label"><%= t('รหัสผ่าน') %></label>
        <input name="password" type="password" placeholder="••••••••" class="input <%= errorField === 'password' ? 'input-error' : '' %>" required />
      </div>
      <button class="btn-primary w-full"><%= t('สมัคร') %></button>
    </form>

    <div class="alert-info mt-5">
      <%= t('หลังสมัคร บัญชีจะเป็นสถานะ "รอตรวจสอบ" จนกว่า admin จะอนุมัติและกำหนด role ให้') %>
    </div>
  </div>
</div>
